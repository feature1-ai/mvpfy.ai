{
  "name": "mvpfy",
  "version": "1.0.0-beta.1",
  "description": "The IDE for PMs — ship Feature1 user stories as pull requests with one click, powered by Claude Code and Codex CLI.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Abdul Rahman K",
    "email": "kadkab.abdul@gmail.com"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc --noEmit -p tsconfig.json && vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "package": "npm run build && electron-builder --mac --dir",
    "package:all": "npm run build && electron-builder --mac --win --linux",
    "test": "vitest run",
    "lint": "eslint . && prettier --check \"{src,electron,shared}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{src,electron,shared}/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "js-yaml": "^5.2.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.39",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.3.4",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "ai.feature1.mvpfy",
    "productName": "mvpfy by feature1",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    }
  }
}
